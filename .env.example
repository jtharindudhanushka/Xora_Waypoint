# ── Copy to .env and adjust. Never commit .env. ──

# Database (the compose service "db")
POSTGRES_USER=xora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xora
DATABASE_URL=postgresql+psycopg://xora:change-me@db:5432/xora

# API
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=12
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO

# Competition dataset pack (local only; never committed). Path as seen by the host for compose mounts.
DATASET_DIR=./datasets

# Demo
DEMO_START=2026-04-06T14:50:00+05:30
SEED_RESET_DEMO=false   # true wipes and re-seeds the demo day on every start
TZ=Asia/Colombo

# Production only (docker-compose.prod.yml / Caddy)
PUBLIC_HOST=localhost

# Optional: language-AI phrasing for notices (off by default; templates are used)
LLM_ENABLED=false
LLM_API_KEY=
